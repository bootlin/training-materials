From 151a4dd794d2fb6a4b61fa939d02de4d5e176e2a Mon Sep 17 00:00:00 2001
From: Luca Ceresoli <luca.ceresoli@bootlin.com>
Date: Tue, 12 Jul 2022 14:04:44 +0200
Subject: [PATCH 3/3] ARM: dts: stm32mp157d-dk1: add description of Nunchuk on
 I2C5

Upstream-Status: Inappropriate
Signed-off-by: Luca Ceresoli <luca.ceresoli@bootlin.com>
---
 arch/arm/boot/dts/st/stm32mp157d-dk1.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/boot/dts/st/stm32mp157d-dk1.dts b/arch/arm/boot/dts/st/stm32mp157d-dk1.dts
index e6d2e7c5e7ca..5609f6331aa2 100644
--- a/arch/arm/boot/dts/st/stm32mp157d-dk1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157d-dk1.dts
@@ -25,3 +25,16 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 };
+
+&i2c5 {
+	status = "okay";
+	clock-frequency = <100000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&i2c5_pins_a>;
+	pinctrl-1 = <&i2c5_sleep_pins_a>;
+
+	nunchuk: nunchuk@52 {
+		compatible = "nintendo,nunchuk";
+		reg = <0x52>;
+	};
+};
-- 
2.47.3


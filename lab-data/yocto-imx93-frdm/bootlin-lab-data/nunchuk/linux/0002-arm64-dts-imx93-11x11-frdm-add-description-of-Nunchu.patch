From 36cb5804955ef121c028dd7955292ebd8a4b1700 Mon Sep 17 00:00:00 2001
From: Joao Marcos Costa <joaomarcos.costa@bootlin.com>
Date: Fri, 12 Dec 2025 16:24:03 +0000
Subject: [PATCH 2/2] arm64: dts: imx93-11x11-frdm: add description of Nunchuk
 on lpi2c1

Upstream-Status: Inappropriate
Signed-off-by: Joao Marcos Costa <joaomarcos.costa@bootlin.com>
Signed-off-by: Mathieu Dubois-Briand <mathieu.dubois-briand@bootlin.com>
---
 arch/arm64/boot/dts/freescale/imx93-11x11-frdm.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm.dts
index 045bee43dbac..676bbe3c0147 100644
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm.dts
@@ -383,7 +383,7 @@ &ldb_phy {
 &lpi2c1 {
 	#address-cells = <1>;
 	#size-cells = <0>;
-	clock-frequency = <400000>;
+	clock-frequency = <100000>;
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&pinctrl_lpi2c1>;
 	pinctrl-1 = <&pinctrl_lpi2c1>;
@@ -411,6 +411,10 @@ pcal6408: gpio@20 {
 		status = "okay";
 	};
 
+	nunchuk: joystick@52 {
+	    compatible = "nintendo,nunchuk";
+	    reg = <0x52>;
+	};
 };
 
 &lpi2c2 {
-- 
2.47.3

